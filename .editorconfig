# How the files of the project are written: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ruff, with its default line length
[*.py]
indent_size = 4
max_line_length = 88

# As Home Assistant writes the texts and icons of its integrations
[custom_components/hikvision_virtual_indoor_station/{strings,icons}.json]
indent_size = 4

[custom_components/hikvision_virtual_indoor_station/translations/*.json]
indent_size = 4

# With tabs, as Home Assistant writes the manifests of integrations
[custom_components/hikvision_virtual_indoor_station/manifest.json]
indent_style = tab

# Unmodified copies of real files: never edited, not even their last line
[tests/fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
