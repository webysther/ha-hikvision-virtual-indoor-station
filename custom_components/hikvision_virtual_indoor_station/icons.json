{
    "entity": {
        "binary_sensor": {
            "sip_registered": {
                "default": "mdi:phone-check",
                "state": {
                    "off": "mdi:phone-off"
                }
            }
        },
        "button": {
            "answer": {
                "default": "mdi:phone"
            },
            "hang_up": {
                "default": "mdi:phone-hangup"
            },
            "open_door": {
                "default": "mdi:door-open"
            },
            "open_door_numbered": {
                "default": "mdi:door-open"
            },
            "reject": {
                "default": "mdi:phone-cancel"
            }
        },
        "event": {
            "doorbell": {
                "default": "mdi:doorbell",
                "state_attributes": {
                    "event_type": {
                        "state": {
                            "ring": "mdi:doorbell-video",
                            "answered": "mdi:phone-in-talk",
                            "rejected": "mdi:phone-cancel",
                            "missed": "mdi:phone-missed",
                            "ended": "mdi:phone-hangup"
                        }
                    }
                }
            }
        },
        "image": {
            "visits_by_hour": {
                "default": "mdi:clock-time-four-outline"
            },
            "visits_by_day": {
                "default": "mdi:chart-bar"
            }
        },
        "number": {
            "microphone_volume": {
                "default": "mdi:microphone"
            },
            "speaker_volume": {
                "default": "mdi:volume-high"
            },
            "talk_volume": {
                "default": "mdi:phone-in-talk"
            },
            "open_time": {
                "default": "mdi:timer-outline"
            },
            "open_time_numbered": {
                "default": "mdi:timer-outline"
            },
            "day_night_sensitivity": {
                "default": "mdi:brightness-auto"
            },
            "brightness": {
                "default": "mdi:brightness-6"
            },
            "contrast": {
                "default": "mdi:contrast-box"
            },
            "saturation": {
                "default": "mdi:palette"
            },
            "sharpness": {
                "default": "mdi:image-filter-center-focus"
            },
            "wdr_level": {
                "default": "mdi:hdr"
            }
        },
        "select": {
            "day_night": {
                "default": "mdi:theme-light-dark",
                "state": {
                    "day": "mdi:weather-sunny",
                    "night": "mdi:weather-night"
                }
            },
            "wdr": {
                "default": "mdi:hdr",
                "state": {
                    "close": "mdi:hdr-off"
                }
            },
            "blc_area": {
                "default": "mdi:select-place"
            },
            "power_line_frequency": {
                "default": "mdi:sine-wave"
            },
            "door_voice_prompt_type": {
                "default": "mdi:account-voice"
            }
        },
        "sensor": {
            "call": {
                "default": "mdi:phone",
                "state": {
                    "idle": "mdi:phone-outline",
                    "ringing": "mdi:phone-ring",
                    "answered": "mdi:phone-in-talk"
                }
            },
            "visits": {
                "default": "mdi:account-group"
            },
            "missed_visits": {
                "default": "mdi:phone-missed"
